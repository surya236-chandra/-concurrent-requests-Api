# Copy this file to .env and fill in your values
# Never commit .env to git

PORT=3000

# For local dev without Docker:
# MONGO_URI=mongodb://localhost:27017/heritage?replicaSet=rs0
# For Docker Compose (service name is "mongo"):
MONGO_URI=mongodb://mongo:27017/heritage?replicaSet=rs0

# Make this long and random - never share it
JWT_SECRET=change_me_to_a_long_random_string
